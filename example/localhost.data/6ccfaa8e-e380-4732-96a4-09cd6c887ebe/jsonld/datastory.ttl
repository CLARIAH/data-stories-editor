<https://stories.clariah.nl/story/6ccfaa8e-e380-4732-96a4-09cd6c887ebe> a ds:DataStory ;
    dcterms:license <http://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:title "The 1918-19 flu epidemic in The Netherlands" ;
    ds:endpoint <https://druid.datalegend.net/dataLegend/deaths-1910-1920/sparql/deaths-1910-1920> ;
    ds:hasBlock ( <https://stories.clariah.nl/story/6ccfaa8e-e380-4732-96a4-09cd6c887ebe/b1> <https://stories.clariah.nl/story/6ccfaa8e-e380-4732-96a4-09cd6c887ebe/b2> <https://stories.clariah.nl/story/6ccfaa8e-e380-4732-96a4-09cd6c887ebe/b3> <https://stories.clariah.nl/story/6ccfaa8e-e380-4732-96a4-09cd6c887ebe/b4> <https://stories.clariah.nl/story/6ccfaa8e-e380-4732-96a4-09cd6c887ebe/b5> <https://stories.clariah.nl/story/6ccfaa8e-e380-4732-96a4-09cd6c887ebe/b7> <https://stories.clariah.nl/story/6ccfaa8e-e380-4732-96a4-09cd6c887ebe/b8> <https://stories.clariah.nl/story/6ccfaa8e-e380-4732-96a4-09cd6c887ebe/b9> <https://stories.clariah.nl/story/6ccfaa8e-e380-4732-96a4-09cd6c887ebe/b10> <https://stories.clariah.nl/story/6ccfaa8e-e380-4732-96a4-09cd6c887ebe/b11> <https://stories.clariah.nl/story/6ccfaa8e-e380-4732-96a4-09cd6c887ebe/b12> <https://stories.clariah.nl/story/6ccfaa8e-e380-4732-96a4-09cd6c887ebe/b13> <https://stories.clariah.nl/story/6ccfaa8e-e380-4732-96a4-09cd6c887ebe/b14> <https://stories.clariah.nl/story/6ccfaa8e-e380-4732-96a4-09cd6c887ebe/b15> <https://stories.clariah.nl/story/6ccfaa8e-e380-4732-96a4-09cd6c887ebe/b16> <https://stories.clariah.nl/story/6ccfaa8e-e380-4732-96a4-09cd6c887ebe/b17> ) ;
    ds:landingPage <https://stories.datalegend.net/spanishFluNetherlands/> ;
    ds:runs [ a ds:Run ;
            ds:resources [ ds:href <https://stories.clariah.nl/story/img/occupation_share-geo.png> ;
                    ds:mime "image/png" ;
                    ds:ref <https://stories.clariah.nl/story/6ccfaa8e-e380-4732-96a4-09cd6c887ebe/b5> ],
                [ ds:href <https://stories.clariah.nl/story/data/standardization_share.csv> ;
                    ds:mime "text/csv" ;
                    ds:ref <https://stories.clariah.nl/story/6ccfaa8e-e380-4732-96a4-09cd6c887ebe/b2> ],
                [ ds:href <https://stories.clariah.nl/story/img/occupation_share-geo.csv> ;
                    ds:mime "text/csv" ;
                    ds:ref <https://stories.clariah.nl/story/6ccfaa8e-e380-4732-96a4-09cd6c887ebe/b5> ] ;
            ds:when "2022-03-30T12:00:00"^^xsd:dateTime ],
        [ a ds:Run ;
            ds:resources [ ds:href <https://stories.clariah.nl/story/flu.warc.gz> ;
                    ds:mime "application/warc" ] ;
            ds:when "2022-03-16T15:00:00"^^xsd:dateTime ] .

<https://stories.clariah.nl/story/6ccfaa8e-e380-4732-96a4-09cd6c887ebe/b1> a ds:Block ;
    dcterms:title "The dataset" ;
    ds:content """Thanks to the indexation efforts of archives and the [LINKS
            project](https://iisg.amsterdam/en/hsn/projects/links), large parts of the Dutch civil
            registry (_'Burgerlijke Stand'_) are now becoming available for historians. The death
            certificates used here are retrieved from [openarch.nl](https://www.openarch.nl/)
            (available [here](https://www.openarch.nl/exports/5cfb55ebaf9fe5aaf216f6da1229c632/)).
            From the individual death certificates files per archive, one combined dataset was
            created. One challenge of working with these certificates is that that the same
            certificate may have been indexed by more than one archive. These were de-duplicated
            using a combination of date of death, location and similar full names (using string
            distances). Key variables were subsequently cleaned and standardized, such as age at
            death, placenames, and occupations. Using different string match combinations, place
            names were standardized against the [Historical Dutch Toponyms
            dataset](https://iisg.amsterdam/en/hsn/data/place-names), to retrieve coordinates and
            Amsterdam Codes. Occupations were matched against the file [HSN
            Occupations](https://iisg.amsterdam/en/hsn/data/occupations) to retrieve HISCO, HISCLASS
            and HISCAM categorizations. All related R scripts can be found at our [Github
            repository](https://github.com/CLARIAH/wp4-civreg). The dataset was then converted into
            Linked Data with [COW](https://github.com/CLARIAH/COW), using the "Persons table"
            datamodel designed by Gerrit Bloothooft and Kees Mandemakers in the LINKS project. The
            complete Linked Dataset and the related metadata scheme can be explored at
            [Druid](https://druid.datalegend.net/dataLegend/deaths-1910-1920/) The table below
            demonstrates the success of the standardization efforts, presented as Linked Data.""" ;
    ds:cue [ a ds:title-prologue ;
            ds:data "{\"cueType\":\"template\",\"template\":\"# I. {$ds-Block/dct:title}\"}"^^rdf:JSON ] ;
    ds:kind ds:Text ;
    ds:mime "text/markdown" .

<https://stories.clariah.nl/story/6ccfaa8e-e380-4732-96a4-09cd6c887ebe/b10> a ds:Block ;
    ds:content " The next query zooms iothe           excess mortality iNovember 1918, compared to the meadeaths ithe same month between           1910-17. It shows that 's-Hertogenbosch, Finsterwolde, and Harderwijk experienced death           rates well over fifteetimes what was normal. Only nineteeof all 967 municipalities           we have data for experienced below-average mortality rates, and these were mostly caused           by their small size - agaihighlighting the severity of the epidemic. Municipalities           cabe browsed by entering their name ithe searchbar 'Filter query results' just above           the table at the left-hand side, after clicking the blue upward-facing arrow. To put the           municipal rates into context: the overall excess death rate i1918 was about 1.41. " ;
    ds:kind ds:Text ;
    ds:mime "text/markdown" .

<https://stories.clariah.nl/story/6ccfaa8e-e380-4732-96a4-09cd6c887ebe/b11> a ds:Block ;
    dcterms:title "Excess mortality iNovember 1918 per municipality:" ;
    ds:content """
PREFIX xsd:    <http://www.w3.org/2001/XMLSchema#>
PREFIX schema: <http://schema.org/>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX iisgv:  <https://iisg.amsterdam/openarchdeaths1910_1920/vocab/>
PREFIX iisgv2: <https://iisg.amsterdam/openarchdeath/vocab/>
PREFIX gg:     <http://www.gemeentegeschiedenis.nl/gg-schema#>
PREFIX geo:    <http://www.opengis.net/ont/geosparql#>
PREFIX bio:    <http://purl.org/vocab/bio/0.1/>
PREFIX bif:     <http://www.openlinksw.com/schemas/bif#>

SELECT ?gg_gemeente ?mean ?1918 ?excess_death_rate

 WHERE {
   FILTER(?mean >1) # to avoid 'division by 0' error
   FILTER(?1918 >1) FILTER(?month = "11"^^xsd:integer) {
     select ?amco ?wkt ?gg_gemeente ?month
     (sum(if(?year = "1918"^^<http://www.w3.org/2001/XMLSchema#int>, 1, 0)) as ?1918)
     (sum(if(?year = "1910"^^<http://www.w3.org/2001/XMLSchema#int>, 1, 0)) as ?1910)
     (sum(if(?year = "1911"^^<http://www.w3.org/2001/XMLSchema#int>, 1, 0)) as ?1911)
     (sum(if(?year = "1912"^^<http://www.w3.org/2001/XMLSchema#int>, 1, 0)) as ?1912)
     (sum(if(?year = "1913"^^<http://www.w3.org/2001/XMLSchema#int>, 1, 0)) as ?1913)
     (sum(if(?year = "1914"^^<http://www.w3.org/2001/XMLSchema#int>, 1, 0)) as ?1914)
     (sum(if(?year = "1915"^^<http://www.w3.org/2001/XMLSchema#int>, 1, 0)) as ?1915)
     (sum(if(?year = "1916"^^<http://www.w3.org/2001/XMLSchema#int>, 1, 0)) as ?1916)
     (sum(if(?year = "1917"^^<http://www.w3.org/2001/XMLSchema#int>, 1, 0)) as ?1917)

     { ?death a bio:Death .
       ?death iisgv:deceased ?deceased .
       ?death bio:date ?date .
       ?death iisgv:event_location ?gemeente .
       ?gemeente gg:amsterdamCode ?amco .
       ?amco gg:identifies ?gg_gemeente .
       BIND(year(?date) as ?year)
       BIND(month(?date) as ?month)
     }
   }
   BIND(xsd:float(?1910+?1911+?1912+?1913+?1914+?1915+?1916+?1917)/8 as ?mean)
   BIND(xsd:float(?1918/?mean) as ?excess_death_rate)
 }

 ORDER BY DESC (?excess_death_rate) """ ;
    ds:cue [ ds:cueType ds:visualisation ;
            ds:data "{\"type\":\"table\"}"^^rdf:JSON ],
        [ ds:cueType ds:data-output-config ;
            ds:data "{\"pageSize\":10}"^^rdf:JSON ] ;
    ds:kind ds:Query ;
    ds:mime "application/sparql-query" .

<https://stories.clariah.nl/story/6ccfaa8e-e380-4732-96a4-09cd6c887ebe/b12> a ds:Block ;
    dcterms:title "Social distributioof the flu" ;
    ds:content " Icontrast to many other flu outbreaks, it [has been           demonstrated](https://wwwnc.cdc.gov/eid/article/12/1/05-0979-f2) that the 1918-19           epidemic was deadly for young adults iparticular. We cause the age at death to           examine if this holds for The Netherlands as well, and whether this was true during the           wave iNovember 1918 and the first three months of 1919. Surprisingly, only the           November 1918 wave affected young adults i- extremely - large numbers. During the next           outbreak iJanuary-March 1919 the age distributiowas more iline with years without           aepidemic. At the moment we caonly speculate as to why. Perhaps young adults who           overcame the first wave had acquired immunity by 1919, but that does not explaiwhy the           elderly, who had not beeat much risk i1918, were now affected irelatively large           numbers. " ;
    ds:cue [ ds:cueType ds:title-prologue ;
            ds:data "{\"template\":\"# III. {$ds-Metadata/dct:title}\",\"type\":\"template\"}"^^rdf:JSON ] ;
    ds:kind ds:Text ;
    ds:mime "text/markdown" .

<https://stories.clariah.nl/story/6ccfaa8e-e380-4732-96a4-09cd6c887ebe/b13> a ds:Block ;
    ds:content """
PREFIX xsd:    <http://www.w3.org/2001/XMLSchema#>
PREFIX schema: <http://schema.org/>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX iisgv:  <https://iisg.amsterdam/openarchdeaths1910_1920/vocab/>
PREFIX iisgv2: <https://iisg.amsterdam/openarchdeath/vocab/>
PREFIX gg:     <http://www.gemeentegeschiedenis.nl/gg-schema#>
PREFIX geo:    <http://www.opengis.net/ont/geosparql#>
PREFIX bio:    <http://purl.org/vocab/bio/0.1/>

SELECT ?age (?1910/xsd:decimal(?total_1910)*100 as?share_1910)
            (?november_1918/xsd:decimal(?november_1918_total)*100 as ?share_november_1918)
            (?winter_1919/xsd:decimal(?winter_1919_total)*100 as ?share_winter_1919)

 WHERE { { select ?total_1910 ?age ?november_1918_total
                  ?winter_1919_total
                  (sum(if(?year = "1918"^^<http://www.w3.org/2001/XMLSchema#int> && ?month = 11, 1, 0)) as ?november_1918)
                  (sum(if(?year = "1910"^^<http://www.w3.org/2001/XMLSchema#int>, 1, 0)) as ?1910)
                  (sum(if(?year = "1919"^^<http://www.w3.org/2001/XMLSchema#int> && ?month >= 3, 1, 0)) as ?winter_1919)
                  { ?death a bio:Death . ?death iisgv:deceased ?deceased .
                    # ?deceased schema:gender "m" .
                    ?deceased iisgv:ageYears ?age.
                    ?death bio:date ?date .
                    BIND(year(?date) as ?year)
                    BIND(month(?date) as ?month)
                    FILTER(?age > 0) # excluded because there may still be an issue with age=0
                    { select (sum(if(?year = "1910"^^<http://www.w3.org/2001/XMLSchema#int>, 1, 0)) as ?total_1910)
                           (sum(if(?year = "1918"^^<http://www.w3.org/2001/XMLSchema#int> && ?month = 11, 1, 0)) as ?november_1918_total)
                           (sum(if(?year = "1919"^^<http://www.w3.org/2001/XMLSchema#int> && ?month >= 3, 1, 0)) as ?winter_1919_total)
                           { ?death a bio:Death .
                             ?death iisgv:deceased ?deceased .
                             #?deceased schema:gender "m" .
                             ?deceased iisgv:ageYears ?age.
                             ?death bio:date ?date .
                             BIND(year(?date) as ?year)
                             BIND(month(?date) as ?month)
                             FILTER(?age > 0) # excluded because there may still be a slight issue with age=0
                           }
                    }

                  }
 }}

 ORDER BY ASC (?age) """ ;
    ds:cue [ ds:cueType ds:visualisation ;
            ds:data "{\"type\":\"gchart\"}"^^rdf:JSON ],
        [ a ds:data-output-config ;
            ds:data "{\"chartConfig\":{\"chartType\":\"LineChart\",\"options\":{\"dataSets\":[{\"color\":\"rgb(0, 102, 0)\",\"density\":0.1,\"field\":\"share_1910\",\"fill\":true},{\"color\":\"rgb(204, 0, 0)\",\"density\":0.1,\"field\":\"share_november_1918\",\"fill\":true},{\"color\":\"rgb(175, 92, 96)\",\"density\":0.1,\"field\":\"share_winter_1919\",\"fill\":true}],\"labelField\":\"age\"}}}"^^rdf:JSON ] ;
    ds:kind ds:Query ;
    ds:mime "application/sparql-query" .

<https://stories.clariah.nl/story/6ccfaa8e-e380-4732-96a4-09cd6c887ebe/b14> a ds:Block ;
    ds:_text "Last, we examine whether people from           certaioccupations experienced higher death rates thausual. This could suggest they           had a higher exposure to the virus. To do so, occupational titles of the deceased are           grouped under occupational categories, using the HISCO Unit Group code. Only those of           age of 18-45 are examined, to see if their high death rates cabe (partially) explained           by their occupation. Deaths per occupational group i1918 are agaicompared to their           corresponding meaduring 1910-17. The excess death rate of this age group igeneral           was a staggering 2.95, so people from occupational groups above this figure were even           worse off. Next to nurses, who had by nature high exposure to the virus, it shows that           clerks, miners, weavers and fishermedied relatively more oftei1918. Perhaps           working iclosed-off environments, or with many people ithe same place provides an           explanation. Those working mostly outside, such as street vendors, dockers, and brick           layers were better off. Yet some other groups working inside, such as tailors and shoe           makers, were also affected relatively modestly, suggesting that working environments           alone may not provide a sufficient explanation. Iany case, and iline with [other           studies](https://academic.oup.com/aje/article/187/12/2568/5060513#126180950), we observe           no discernable hierarchical relatiobetweesocial class - measured by HISCAM - and           excess mortality. " ;
    ds:kind ds:Text ;
    ds:mime "text/markdown" .

<https://stories.clariah.nl/story/6ccfaa8e-e380-4732-96a4-09cd6c887ebe/b15> a ds:Block ;
    dcterms:title "Excess mortality of those aged 18-45 per occupational group in                   1918:" ;
    ds:content """
PREFIX xsd:    <http://www.w3.org/2001/XMLSchema#>
PREFIX schema: <http://schema.org/> PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX iisgv:  <https://iisg.amsterdam/openarchdeaths1910_1920/vocab/>
PREFIX iisgv2: <https://iisg.amsterdam/openarchdeath/vocab/>
PREFIX gg:     <http://www.gemeentegeschiedenis.nl/gg-schema#>
PREFIX geo:    <http://www.opengis.net/ont/geosparql#>
PREFIX bio:    <http://purl.org/vocab/bio/0.1/>
PREFIX bif:     <http://www.openlinksw.com/schemas/bif#>

SELECT ?unit_group ?occupational_group ?mean ?1918 ?excess

 WHERE {
      FILTER(?mean >5) # to avoid 'division by 0' error
      FILTER(?1918 >0)
      { select ?unit_group ?occupational_group
        (sum(if(?year = "1918"^^<http://www.w3.org/2001/XMLSchema#int>, 1, 0)) as ?1918)
        (sum(if(?year = "1910"^^<http://www.w3.org/2001/XMLSchema#int>, 1, 0)) as ?1910)
        (sum(if(?year = "1911"^^<http://www.w3.org/2001/XMLSchema#int>, 1, 0)) as ?1911)
        (sum(if(?year = "1912"^^<http://www.w3.org/2001/XMLSchema#int>, 1, 0)) as ?1912)
        (sum(if(?year = "1913"^^<http://www.w3.org/2001/XMLSchema#int>, 1, 0)) as ?1913)
        (sum(if(?year = "1914"^^<http://www.w3.org/2001/XMLSchema#int>, 1, 0)) as ?1914)
        (sum(if(?year = "1915"^^<http://www.w3.org/2001/XMLSchema#int>, 1, 0)) as ?1915)
        (sum(if(?year = "1916"^^<http://www.w3.org/2001/XMLSchema#int>, 1, 0)) as ?1916)
        (sum(if(?year = "1917"^^<http://www.w3.org/2001/XMLSchema#int>, 1, 0)) as ?1917)
        { ?death a bio:Death .
          ?death iisgv:deceased ?deceased .
          ?deceased iisgv:ageYears ?age .
          ?deceased schema:hasOccupation ?occ.
          ?occ schema:categoryCode ?hisco .
          ?hisco rdfs:subClassOf ?unit_group .
          ?unit_group schema:name ?occupational_group .
          ?death bio:date ?date .
          BIND(year(?date) as ?year)
          FILTER(?age >= 18 && ?age <= 45)
        }
      }
      BIND(xsd:float(?1910+?1911+?1912+?1913+?1914+?1915+?1916+?1917)/8 as ?mean)
      BIND(xsd:decimal(?1918/?mean) as ?excess) } ORDER BY DESC (?excess) """ ;
    ds:cue [ ds:cueType ds:data-output-config ;
            ds:data "{\"pageSize\":10}"^^rdf:JSON ],
        [ ds:cueType ds:visualisation ;
            ds:data "{\"type\":\"table\"}"^^rdf:JSON ] ;
    ds:kind ds:Query ;
    ds:mime "application/sparql-query" .

<https://stories.clariah.nl/story/6ccfaa8e-e380-4732-96a4-09cd6c887ebe/b16> a ds:Block ;
    dcterms:title "Correlatiobetweemeaexcess mortality (ages 18-45) and social class                   :" ;
    ds:content """
PREFIX xsd:    <http://www.w3.org/2001/XMLSchema#>
PREFIX schema: <http://schema.org/>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX iisgv:  <https://iisg.amsterdam/openarchdeaths1910_1920/vocab/>
PREFIX iisgv2: <https://iisg.amsterdam/openarchdeath/vocab/>
PREFIX gg:     <http://www.gemeentegeschiedenis.nl/gg-schema#>
PREFIX geo:    <http://www.opengis.net/ont/geosparql#>
PREFIX bio:    <http://purl.org/vocab/bio/0.1/>
PREFIX bif:    <http://www.openlinksw.com/schemas/bif#>

SELECT ?hiscam ?excess

 WHERE {

         FILTER(?mean >2) # to avoid 'division by 0'
         FILTER(?1918 >0) {
           select ?hiscam (sum(if(?year =
            "1918"^^<http://www.w3.org/2001/XMLSchema#int>, 1, 0)) as ?1918)
            (sum(if(?year = "1910"^^<http://www.w3.org/2001/XMLSchema#int>, 1, 0)) as ?1910)
            (sum(if(?year = "1911"^^<http://www.w3.org/2001/XMLSchema#int>, 1, 0)) as ?1911)
            (sum(if(?year = "1912"^^<http://www.w3.org/2001/XMLSchema#int>, 1, 0)) as ?1912)
            (sum(if(?year = "1913"^^<http://www.w3.org/2001/XMLSchema#int>, 1, 0)) as ?1913)
            (sum(if(?year = "1914"^^<http://www.w3.org/2001/XMLSchema#int>, 1, 0)) as ?1914)
            (sum(if(?year = "1915"^^<http://www.w3.org/2001/XMLSchema#int>, 1, 0)) as ?1915)
            (sum(if(?year = "1916"^^<http://www.w3.org/2001/XMLSchema#int>, 1, 0)) as ?1916)
            (sum(if(?year = "1917"^^<http://www.w3.org/2001/XMLSchema#int>, 1, 0)) as ?1917)
            { ?death a bio:Death .
              ?death iisgv:deceased ?deceased .
              ?deceased iisgv:ageYears ?age .
              ?deceased schema:hasOccupation ?occ .
              ?occ iisgv2:hiscam_nl ?hiscam .
              ?death bio:date ?date .

              BIND(year(?date) as ?year)
              FILTER(?age >= 18 && ?age <= 45)
              FILTER(?hiscam >39)
            }
           }
           BIND(xsd:float(?1910+?1911+?1912+?1913+?1914+?1915+?1916+?1917)/8 as ?mean)
           BIND(xsd:decimal(?1918/?mean) as ?excess)
       }

 ORDER BY DESC (?excess) """ ;
    ds:cue [ ds:cueType ds:visualisation ;
            ds:data "{\"type\":\"gchart\"}"^^rdf:JSON ],
        [ ds:cueType ds:data-output-config ;
            ds:data "{\"chartConfig\":{\"chartType\":\"ScatterChart\",\"options\":{\"dataSets\":[{\"color\":\"rgb(204, 0, 0)\",\"label\":\"Excess death rate\",\"x-field\":\"hiscam\",\"y-field\":\"excess\"}]}}}"^^rdf:JSON ] ;
    ds:kind ds:Query ;
    ds:mime "application/sparql-query" .

<https://stories.clariah.nl/story/6ccfaa8e-e380-4732-96a4-09cd6c887ebe/b17> a ds:Block ;
    dcterms:title "Conclusion" ;
    ds:content " By using Linked Data to connect Dutch death certificates to other datasets,           such as Gemeentegeschiedenis and HISCO, we cafor the first time attempt an           encompassing study into the 1918-19 epidemic. Our, still preliminary, results suggest           that the odds of meeting someone who carried the virus probably mattered most, and that           this was partially affected by working environments, such as the number of co-workers           and working inside, and also by where you lived iThe Netherlands. Some regions, such           as Groningen, were notably more affected thaothers. The next step would be to study           these variables icombination, and set up a case-control study comparing the           social-demographic structure of such regions with regions or municipalities that were           affected to a smaller degree. Ithe near future we will also be able to link these           death certificates across the complete civil registry, allowing to reconstruct family           trees. Ithis way it will be possible to take into account household compositioand           genetic traits as well, such as a comparisoof mortality betweesiblings or between           different generations of the same family. " ;
    ds:cue [ ds:cueType ds:title-prologue ;
            ds:data "{\"template\":\"# I. {$ds-Metadata/dct:title}\",\"type\":\"template\"}"^^rdf:JSON ] ;
    ds:kind ds:Text ;
    ds:mime "text/markdown" .

<https://stories.clariah.nl/story/6ccfaa8e-e380-4732-96a4-09cd6c887ebe/b3> a ds:Block ;
    ds:content " _Sources:_ Gerrit Bloothooft &           Kees Mandemakers, _[The Zeeland           Challenge](http://www.gerritbloothooft.nl/Publications/The%20Zeeland%20Challenge%20v2-2.pdf)_,           document for benchmark, presented at workshop Data Linkage: Techniques, Challenges and           Applications at Isaac NewtoInstitute for Mathematics, Cambridge, UK, 15 September           2016; VaLeeuwen, M. H. D. , Maas, I. & Miles, A. (2003). _HISCO: Historical           International Standard Classificatioof Occupations_. Leuven: LeuveUniversity Press;           Zijdeman, R., & Lambert, P. (2010). _Measuring social structure ithe past: A           comparisoof historical class schemes and occupational stratificatioscales oDutch           19th and early 20th century data_. Journal of BelgiaHistory/Belgisch Tijdschrift voor           Nieuwste Geschiedenis/Revue Belge de Histoire Contemporaine, 40(1-2), 111-141. " ;
    ds:kind ds:Text ;
    ds:mime "text/markdown" .

<https://stories.clariah.nl/story/6ccfaa8e-e380-4732-96a4-09cd6c887ebe/b4> a ds:Block ;
    ds:content " Because archives generally decide           for themselves which variables from the civil registry they will index, occupations of           the deceased are not available for all regions. Archives from the provinces of Drenthe,           Gelderland, and Zeeland are, regrettably, the only ones to have structurally indexed all           occupations of the deceased for this period. " ;
    ds:kind ds:Text ;
    ds:mime "text/markdown" .

<https://stories.clariah.nl/story/6ccfaa8e-e380-4732-96a4-09cd6c887ebe/b7> a ds:Block ;
    dcterms:title "Total deaths iThe Netherlands by month:" ;
    ds:content """
PREFIX xsd:    <http://www.w3.org/2001/XMLSchema#>
PREFIX schema: <http://schema.org/>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX iisgv:  <https://iisg.amsterdam/openarchdeaths1910_1920/vocab/>
PREFIX iisgv2: <https://iisg.amsterdam/openarchdeath/vocab/>
PREFIX gg:     <http://www.gemeentegeschiedenis.nl/gg-schema#>
PREFIX geo:    <http://www.opengis.net/ont/geosparql#>
PREFIX bio:    <http://purl.org/vocab/bio/0.1/>

SELECT ?month (sum(if(?year = "1910"^^<http://www.w3.org/2001/XMLSchema#int>, 1, 0)) as ?1910)
              (sum(if(?year = "1913"^^<http://www.w3.org/2001/XMLSchema#int>, 1, 0)) as ?1913)
              (sum(if(?year = "1918"^^<http://www.w3.org/2001/XMLSchema#int>, 1, 0)) as ?1918)
              (sum(if(?year = "1919"^^<http://www.w3.org/2001/XMLSchema#int>, 1, 0)) as ?1919)

 WHERE { ?death a bio:Death .
         ?death iisgv:deceased ?deceased .
         ?death bio:date ?date .
         BIND((month(?date)) as ?month)
         BIND(year(?date) as ?year)
       }

 ORDER BY ASC (?month) """ ;
    ds:cue [ ds:cueType ds:visualisation ;
            ds:data "{\"type\":\"gchart\"}"^^rdf:JSON ],
        [ ds:cueType ds:data-output-config ;
            ds:data "{\"chartConfig\":{\"chartType\":\"LineChart\",\"options\":{\"dataSets\":[{\"color\":\"rgb(0, 102, 0)\",\"density\":0.1,\"field\":\"1910\",\"fill\":true},{\"color\":\"rgb(0, 10, 20)\",\"density\":0.1,\"field\":\"1913\",\"fill\":true},{\"color\":\"rgb(104, 102, 0)\",\"density\":0.1,\"field\":\"1918\",\"fill\":true},{\"color\":\"rgb(40, 102, 80)\",\"density\":0.1,\"field\":\"1919\",\"fill\":true}],\"labelField\":\"month\"}}}"^^rdf:JSON ] ;
    ds:kind ds:Query ;
    ds:mime "application/sparql-query" .

<https://stories.clariah.nl/story/6ccfaa8e-e380-4732-96a4-09cd6c887ebe/b8> a ds:Block ;
    ds:content " Linking the Amsterdam Codes iour           dataset to those i[Gemeentegeschiedenis](https://www.gemeentegeschiedenis.nl/), as           above, allows to map the spatial distributioof the epidemic. We compared total deaths           by municipality i1918 with the meanumber of deaths during 1910-17. Excess death           rates were divided into three catagories: municipalities with excess death rates below           the meaof 1.38 (light red); those with rates from 1.38 through 1.60 (red); and           municipalities with evehigher excess death rates (dark red). The map suggests hotbeds           of the epidemic iGroningen, Drenthe, and Limburg, with smaller clusters iparts of           North-Brabant and North-Holland. The Achterhoek, the south west of North-Brabant and           Schouwen-Duiveland seem to have beeaffected relatively less severe. By hovering over           the map, the excess death rate and the name of the municipality will show. " ;
    ds:kind ds:Text ;
    ds:mime "text/markdown" .

<https://stories.clariah.nl/story/6ccfaa8e-e380-4732-96a4-09cd6c887ebe/b9> a ds:Block ;
    dcterms:title "Excess mortality i1918:" ;
    ds:cue [ ds:cueType ds:visualisation ;
            ds:data "{\"type\":\"geo\"}"^^rdf:JSON ] ;
    ds:href <https://stories.clariah.nl/story/queries/deaths_spatial.rq> ;
    ds:kind ds:Query ;
    ds:mime "application/sparql-query" .

